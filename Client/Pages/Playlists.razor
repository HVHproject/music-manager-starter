@page "/playlists"
@using music_manager_starter.Shared
@inject HttpClient Http
@inject IJSRuntime JS

<div class="min-h-screen bg-gradient-to-tl from-gray-900 to-gray-800 p-4 md:p-8">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-white">Playlists</h1>
            <p class="text-gray-400 mt-2">Create and manage your music playlists</p>
        </div>

        <div class="flex flex-col lg:flex-row gap-6">
            <!-- Left Panel - Playlist List -->
            <div class="lg:w-1/3">
                <div class="bg-gray-800 rounded-xl shadow-2xl p-6 border border-gray-700">
                    <div class="mb-6">
                        <h2 class="text-xl font-semibold text-gray-100 mb-4">Your Playlists</h2>

                        <!-- Create Playlist Form -->
                        <div class="space-y-4">
                            <div>
                                <label for="playlistName" class="block text-sm font-medium text-gray-300 mb-2">
                                    New Playlist
                                </label>
                                <input id="playlistName"
                                       type="text"
                                       class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 text-white rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 placeholder-gray-400"
                                       placeholder="Enter playlist name..."
                                       @bind="newPlaylistName"
                                       @bind:event="oninput" />
                            </div>

                            <button class="w-full py-3 bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-700 hover:to-indigo-600 text-white font-medium rounded-lg transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-800 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
                                    @onclick="CreatePlaylist"
                                    disabled="@string.IsNullOrWhiteSpace(newPlaylistName)">
                                <div class="flex items-center justify-center">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                    </svg>
                                    Create Playlist
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Playlist List -->
                    <div class="space-y-2">
                        <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-2">
                            All Playlists (@playlists.Count)
                        </h3>

                        @if (playlists.Count == 0)
                        {
                            <div class="text-center py-8 text-gray-500">
                                <svg class="w-12 h-12 mx-auto text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                                </svg>
                                <p class="mt-2 text-gray-400">No playlists yet</p>
                            </div>
                        }
                        else
                        {
                            <div class="pr-2 space-y-2">
                                @foreach (var playlist in playlists)
                                {
                                    <div class="group cursor-pointer transition-all duration-200"
                                         @onclick="() => SelectPlaylist(playlist)">
                                        <div class="@($"flex items-center justify-between p-3 rounded-lg border transition-all duration-200 {(playlist.Id == selectedPlaylist?.Id ? "border-indigo-500 bg-gray-700" : "border-gray-700 hover:border-indigo-400 hover:bg-gray-700")}")">
                                            <div class="flex items-center space-x-3">
                                                <div class="@($"p-2 rounded-lg {(playlist.Id == selectedPlaylist?.Id ? "bg-indigo-900/30" : "bg-gray-700")}")">
                                                    <svg class="w-5 h-5 @(playlist.Id == selectedPlaylist?.Id ? "text-indigo-400" : "text-gray-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                                                    </svg>
                                                </div>
                                                <div>
                                                    <p class="font-medium text-gray-100 truncate">@playlist.Name</p>
                                                    <p class="text-xs text-gray-400">
                                                        @playlist.PlaylistSongs.Count song@(playlist.PlaylistSongs.Count != 1 ? "s" : "")
                                                    </p>
                                                </div>
                                            </div>
                                            @if (playlist.Id == selectedPlaylist?.Id)
                                            {
                                                <div class="w-2 h-2 bg-indigo-500 rounded-full animate-pulse"></div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Panel - Selected Playlist Details -->
            <div class="lg:w-2/3">
                @if (selectedPlaylist is null)
                {
                    <!-- Empty State -->
                    <div class="bg-gray-800 rounded-xl shadow-2xl p-8 h-full flex flex-col items-center justify-center border border-gray-700">
                        <svg class="w-24 h-24 text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                        </svg>
                        <h3 class="text-xl font-semibold text-gray-300 mb-2">Select a Playlist</h3>
                        <p class="text-gray-400 text-center max-w-md">
                            Choose a playlist from the left panel to view and manage its songs
                        </p>
                    </div>
                }
                else
                {
                    <div class="bg-gray-800 rounded-xl shadow-2xl overflow-hidden h-full border border-gray-700">
                        <!-- Playlist Header -->
                        <div class="bg-gradient-to-r from-gray-900 to-gray-800 border-b border-gray-700 p-6">
                            <div class="flex items-center justify-between">
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center space-x-3">
                                        <div class="p-2 rounded-lg bg-indigo-900/30">
                                            <svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                                            </svg>
                                        </div>
                                        <div>
                                            <h2 class="text-2xl font-bold text-white truncate">@selectedPlaylist.Name</h2>
                                            <p class="text-gray-400 mt-1">
                                                Created @selectedPlaylist.CreatedAt.ToString("MMM dd, yyyy")
                                                • @selectedPlaylist.PlaylistSongs.Count song@(selectedPlaylist.PlaylistSongs.Count != 1 ? "s" : "")
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center space-x-1 mr-2">
                                    <button class="p-2 text-indigo-400 hover:text-indigo-300 hover:bg-gray-700 rounded-lg transition-colors"
                                            title="Add songs"
                                            @onclick="ShowAddSongsModal">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M12 4v16m8-8H4" />
                                        </svg>
                                    </button>

                                    <!-- Bulk Delete Mode Toggle -->
                                    <button class="p-2 @(isBulkDeleteMode ? "text-red-500 bg-red-900/30" : "text-gray-400 hover:text-gray-300") hover:bg-gray-700 rounded-lg transition-colors"
                                            title="@(isBulkDeleteMode ? "Exit bulk delete mode" : "Enter bulk delete mode")"
                                            @onclick="ToggleBulkDeleteMode">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                        </svg>
                                    </button>

                                    <!-- Undo -->
                                    <button class="p-2 text-gray-500 hover:text-gray-300 hover:bg-gray-700 rounded-lg transition-colors"
                                            title="Undo (coming soon)"
                                            disabled>
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M3 7v6h6M3 13a9 9 0 1115.364 5.364" />
                                        </svg>
                                    </button>

                                    <!-- Redo -->
                                    <button class="p-2 text-gray-500 hover:text-gray-300 hover:bg-gray-700 rounded-lg transition-colors"
                                            title="Redo (coming soon)"
                                            disabled>
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M21 7v6h-6M21 13A9 9 0 105.636 18.364" />
                                        </svg>
                                    </button>
                                </div>


                                <!-- Three-dot menu button -->
                                <div class="relative" @onclick:stopPropagation>
                                    <button class="p-2 text-gray-400 hover:text-white hover:bg-gray-700 rounded-lg transition-colors duration-200"
                                            @onclick="() => showMenu = !showMenu">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
                                        </svg>
                                    </button>

                                    <!-- Dropdown Menu -->
                                    @if (showMenu)
                                    {
                                        <div class="absolute right-0 mt-2 w-48 bg-gray-800 border border-gray-700 rounded-lg shadow-2xl z-10">
                                            <div class="py-1">
                                                <!-- Rename Option -->
                                                <button class="flex items-center w-full px-4 py-2 text-sm text-gray-300 hover:bg-gray-700 transition-colors duration-150"
                                                        @onclick="async () => { showMenu = false; ShowRenameModal(); }">
                                                    <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                    Rename Playlist
                                                </button>

                                                <!-- Exporet as CSV Option -->
                                                <button class="flex items-center w-full px-4 py-2 text-sm text-gray-300 hover:bg-gray-700 transition-colors duration-150"
                                                        title="Export Playlist as CSV"
                                                        @onclick="ExportSelectedPlaylistCsv">
                                                    <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                                    </svg>
                                                    Export as CSV
                                                </button>


                                                <!-- Delete Option -->
                                                <button class="flex items-center w-full px-4 py-2 text-sm text-red-400 hover:bg-gray-700 transition-colors duration-150"
                                                        @onclick="async () => { showMenu = false; ShowDeleteModal(); }">
                                                    <svg class="w-4 h-4 mr-3 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    Delete Playlist
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Playlist Content -->
                        <div class="p-6">
                            @if (!selectedPlaylist.PlaylistSongs.Any())
                            {
                                <!-- Empty Playlist State -->
                                <div class="text-center py-12">
                                    <svg class="w-16 h-16 mx-auto text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                                    </svg>
                                    <h3 class="text-lg font-medium text-gray-300 mb-2">No songs in this playlist</h3>
                                    <p class="text-gray-400">Add songs to create your perfect playlist</p>
                                </div>
                            }
                            else
                            {
                                <!-- Songs List -->
                                <div class="space-y-3">
                                    <div class="flex items-center justify-between mb-4">
                                        <h3 class="text-lg font-semibold text-gray-200">
                                            Songs (@selectedPlaylist.PlaylistSongs.Count)
                                        </h3>
                                        <span class="text-sm text-gray-400">
                                            Drag to reorder
                                        </span>
                                    </div>

                                    <div class="space-y-2" id="songList">
                                        @for (int i = 0; i < orderedSongs.Count; i++)
                                        {
                                            var index = i;
                                            var ps = orderedSongs[index];

                                            <div class="group flex items-center space-x-4 p-4 bg-gray-700/50 hover:bg-gray-700 border border-gray-600 hover:border-indigo-400 rounded-lg transition-all duration-200 hover:shadow-lg"
                                                 data-song-id="@ps.SongId">

                                                @if (isBulkDeleteMode)
                                                {
                                                    <input type="checkbox"
                                                           class="w-5 h-5 rounded border-gray-600 bg-gray-800 text-red-600 focus:ring-red-500 focus:ring-offset-gray-800"
                                                           checked="@bulkDeleteSelectedIds.Contains(ps.SongId)"
                                                           @onchange="() => ToggleBulkDeleteSelection(ps.SongId)" />
                                                }
                                                else
                                                {
                                                    <!-- Drag Handle -->
                                                    <div class="drag-handle text-gray-500 hover:text-gray-300 transition-colors cursor-move flex-shrink-0">
                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
                                                        </svg>
                                                    </div>
                                                }

                                                <!-- Song Info -->
                                                <div class="flex-1 min-w-0">
                                                    <p class="font-semibold text-white truncate text-base">@ps.Song.Title</p>
                                                    <div class="flex items-center gap-2 text-sm text-gray-400 mt-1">
                                                        <span class="truncate">@ps.Song.Artist</span>
                                                        @if (!string.IsNullOrEmpty(ps.Song.Album))
                                                        {
                                                            <span class="text-gray-600">•</span>
                                                            <span class="truncate">@ps.Song.Album</span>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Metadata Info -->
                                                <div class="flex items-center gap-2 flex-shrink-0">
                                                    @if (!string.IsNullOrEmpty(ps.Song.Genre))
                                                    {
                                                        <span class="px-2.5 py-1 text-xs font-medium bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 rounded-full">
                                                            @ps.Song.Genre
                                                        </span>
                                                    }
                                                    @if (ps.Song.YearReleased.HasValue)
                                                    {
                                                        <span class="px-2.5 py-1 text-xs font-medium bg-gray-800 text-gray-300 border border-gray-600 rounded-full">
                                                            @ps.Song.YearReleased
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Playlist Footer Actions -->
                        @if (selectedPlaylist.PlaylistSongs.Any())
                        {
                            <div class="border-t border-gray-700 p-4 bg-gray-800/50">
                                @if (isBulkDeleteMode)
                                {
                                    <!-- Bulk Delete Action Bar -->
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center space-x-4">
                                            <span class="text-sm font-medium text-gray-300">
                                                @bulkDeleteSelectedIds.Count song@(bulkDeleteSelectedIds.Count != 1 ? "s" : "") selected
                                            </span>
                                            @if (bulkDeleteSelectedIds.Count > 0)
                                            {
                                                <button class="text-sm text-red-400 hover:text-red-300"
                                                        @onclick="SelectAllSongsForBulkDelete">
                                                    Select all
                                                </button>
                                                <button class="text-sm text-gray-400 hover:text-gray-300"
                                                        @onclick="ClearBulkDeleteSelection">
                                                    Clear selection
                                                </button>
                                            }
                                        </div>

                                        <div class="flex items-center space-x-2">
                                            <button class="px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-gray-700 rounded-lg transition-colors"
                                                    @onclick="CancelBulkDelete">
                                                Cancel
                                            </button>
                                            <button class="px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                                    disabled="@(bulkDeleteSelectedIds.Count == 0)"
                                                    @onclick="ConfirmBulkDelete">
                                                <div class="flex items-center">
                                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    Delete (@bulkDeleteSelectedIds.Count)
                                                </div>
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center justify-between">
                                        <div class="text-sm text-gray-400">
                                            <span class="font-medium text-gray-300">Tip:</span> Use drag and drop to reorder songs
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Rename Modal -->
@if (showRenameModal)
{
    <div class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50 p-4" @onclick="CloseModals">
        <div class="bg-gray-800 rounded-xl shadow-2xl border border-gray-700 max-w-md w-full" @onclick:stopPropagation>
            <div class="p-6">
                <h3 class="text-xl font-bold text-white mb-2">Rename Playlist</h3>
                <p class="text-gray-400 mb-6">Enter a new name for "@selectedPlaylist?.Name"</p>

                <input type="text"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 text-white rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 placeholder-gray-400 mb-6"
                       placeholder="New playlist name..."
                       @bind="renamePlaylistName"
                       @bind:event="oninput" />

                <div class="flex justify-end space-x-3">
                    <button class="px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 rounded-lg transition-colors duration-200"
                            @onclick="CloseModals">
                        Cancel
                    </button>
                    <button class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
                            @onclick="RenamePlaylist"
                            disabled="@string.IsNullOrWhiteSpace(renamePlaylistName)">
                        Rename
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50 p-4" @onclick="CloseModals">
        <div class="bg-gray-800 rounded-xl shadow-2xl border border-gray-700 max-w-md w-full" @onclick:stopPropagation>
            <div class="p-6">
                <div class="flex items-center justify-center w-12 h-12 bg-red-900/30 rounded-full mb-4 mx-auto">
                    <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.346 16.5c-.77.833.192 2.5 1.732 2.5z" />
                    </svg>
                </div>

                <h3 class="text-xl font-bold text-white mb-2 text-center">Delete Playlist</h3>
                <p class="text-gray-400 mb-6 text-center">
                    Are you sure you want to delete "<span class="text-white">@selectedPlaylist?.Name</span>"?
                    This action cannot be undone.
                </p>

                <div class="flex justify-center space-x-3">
                    <button class="px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 rounded-lg transition-colors duration-200"
                            @onclick="CloseModals">
                        Cancel
                    </button>
                    <button class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition-colors duration-200"
                            @onclick="DeletePlaylist">
                        Delete Playlist
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Add Songs Modal -->
@if (showAddSongsModal)
{
    <div class="fixed inset-0 bg-black/70 flex items-center justify-center z-50 p-4"
         @onclick="CloseModals">
        <div class="bg-gray-800 rounded-xl shadow-2xl border border-gray-700 w-full max-w-3xl h-[80vh] flex flex-col"
             @onclick:stopPropagation>

            <!-- Header -->
            <div class="p-4 border-b border-gray-700 flex justify-between items-center">
                <h3 class="text-lg font-semibold text-white">Add Songs to "@selectedPlaylist?.Name"</h3>
                <button class="text-gray-400 hover:text-white" @onclick="CloseModals">
                    ✕
                </button>
            </div>

            <!-- Search -->
            <div class="p-4 border-b border-gray-700">
                <input class="w-full px-4 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400"
                       placeholder="Search songs by title, artist, or album..."
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await SearchSongs(); })" />

                <div class="mt-2">
                    <button class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition-colors"
                            @onclick="SearchSongs">
                        Search
                    </button>
                </div>
            </div>

            <!-- Results -->
            <div class="flex-1 overflow-y-auto p-4 space-y-2">
                @if (isSearching)
                {
                    <div class="flex justify-center items-center h-32">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-500"></div>
                        <span class="ml-3 text-gray-400">Searching...</span>
                    </div>
                }
                else if (searchResults == null)
                {
                    <p class="text-gray-400 text-center py-8">Enter a search term to find songs</p>
                }
                else if (!searchResults.Any())
                {
                    <p class="text-gray-400 text-center py-8">No songs found. Try a different search.</p>
                }
                else
                {
                    <div class="text-sm text-gray-400 mb-2">
                        @selectedSongIds.Count song@(selectedSongIds.Count != 1 ? "s" : "") selected
                        @if (selectedSongIds.Any())
                        {
                            <button class="ml-4 text-indigo-400 hover:text-indigo-300"
                                    @onclick="ClearSelection">
                                Clear selection
                            </button>
                        }
                    </div>

                    @foreach (var song in searchResults)
                    {
                        <div class="flex items-center gap-3 p-3 bg-gray-700 rounded hover:bg-gray-600 transition-colors">
                            <input type="checkbox"
                                   class="w-5 h-5 rounded border-gray-600 bg-gray-800 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-gray-800"
                                   checked="@selectedSongIds.Contains(song.Id)"
                                   @onchange="() => ToggleSongSelection(song.Id)" />

                            <div class="flex-1 min-w-0">
                                <div class="text-white font-medium truncate">
                                    @song.Title
                                </div>
                                <div class="text-sm text-gray-400 truncate">
                                    @song.Artist • @song.Album
                                </div>
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="px-2 py-0.5 text-xs font-medium bg-gray-800 text-gray-300 rounded-full">
                                        @song.Genre
                                    </span>
                                    @if (song.YearReleased.HasValue)
                                    {
                                        <span class="text-xs text-gray-500">
                                            @song.YearReleased
                                        </span>
                                    }
                                </div>
                            </div>

                            @if (song.AverageRating.HasValue)
                            {
                                <div class="flex items-center">
                                    <svg class="w-4 h-4 text-yellow-500 fill-current" viewBox="0 0 20 20">
                                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                                    </svg>
                                    <span class="ml-1 text-sm text-gray-300">
                                        @song.AverageRating.Value.ToString("0.0")
                                    </span>
                                </div>
                            }
                        </div>
                    }

                    @if (hasMoreSearchResults && searchResults.Any())
                    {
                        <div class="flex justify-center mt-4">
                            <button class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                    disabled="@isLoadingMore"
                                    @onclick="LoadMoreSearchResults">
                                @(isLoadingMore ? "Loading..." : "Load More")
                            </button>
                        </div>
                    }
                }
            </div>

            <!-- Footer -->
            <div class="p-4 border-t border-gray-700 flex justify-between items-center">
                <span class="text-sm text-gray-400">
                    @selectedSongIds.Count song@(selectedSongIds.Count != 1 ? "s" : "") selected
                </span>

                <div class="flex gap-2">
                    <button class="px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 rounded-lg transition-colors"
                            @onclick="CloseModals">
                        Cancel
                    </button>
                    <button class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                            disabled="@(!selectedSongIds.Any())"
                            @onclick="AddSelectedSongs">
                        Add @selectedSongIds.Count Song@(selectedSongIds.Count != 1 ? "s" : "")
                    </button>
                </div>
            </div>
        </div>
    </div>
}


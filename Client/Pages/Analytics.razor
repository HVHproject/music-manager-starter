@page "/analytics"
@using music_manager_starter.Shared
@using System.Linq
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="min-h-screen bg-gray-900 text-white p-6">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold">Music Analytics Dashboard</h1>
                <p class="text-gray-400 mt-2">Insights and trends from your music library</p>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="flex justify-center items-center h-64">
                <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-purple-500"></div>
            </div>
        }
        else
        {
            <!-- Summary Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <div class="glass p-6 rounded-xl">
                    <div class="flex items-center">
                        <div class="p-3 bg-purple-500/20 rounded-lg">
                            <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-gray-400 text-sm">Total Songs</p>
                            <p class="text-2xl font-bold">@summary?.TotalSongs</p>
                        </div>
                    </div>
                </div>

                <div class="glass p-6 rounded-xl">
                    <div class="flex items-center">
                        <div class="p-3 bg-blue-500/20 rounded-lg">
                            <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-gray-400 text-sm">Total Ratings</p>
                            <p class="text-2xl font-bold">@summary?.TotalRatings</p>
                        </div>
                    </div>
                </div>

                <div class="glass p-6 rounded-xl">
                    <div class="flex items-center">
                        <div class="p-3 bg-green-500/20 rounded-lg">
                            <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-gray-400 text-sm">Active Users</p>
                            <p class="text-2xl font-bold">@summary?.TotalUsers</p>
                        </div>
                    </div>
                </div>

                <div class="glass p-6 rounded-xl">
                    <div class="flex items-center">
                        <div class="p-3 bg-yellow-500/20 rounded-lg">
                            <svg class="w-8 h-8 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-gray-400 text-sm">Avg Rating</p>
                            <p class="text-2xl font-bold">@(summary?.OverallAverageRating.ToString("F1") ?? "0.0")</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Most Rated Songs -->
                <div class="glass p-6 rounded-xl">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold">Most Rated Songs</h2>
                        <div class="flex space-x-2">
                            <button @onclick="() => ChangeTopN(5)"
                                    class="px-3 py-1 text-sm @(topN == 5 ? "bg-purple-700" : "bg-gray-700") rounded">
                                Top 5
                            </button>
                            <button @onclick="() => ChangeTopN(10)"
                                    class="px-3 py-1 text-sm @(topN == 10 ? "bg-purple-700" : "bg-gray-700") rounded">
                                Top 10
                            </button>
                            <button @onclick="() => ChangeTopN(20)"
                                    class="px-3 py-1 text-sm @(topN == 20 ? "bg-purple-700" : "bg-gray-700") rounded">
                                Top 20
                            </button>
                        </div>
                    </div>

                    <div class="space-y-4">
                        @foreach (var song in mostRatedSongs)
                        {
                            <div class="flex items-center justify-between p-4 bg-gray-800/50 rounded-lg hover:bg-gray-800 transition">
                                <div class="flex-1">
                                    <div class="flex items-center">
                                        <div class="w-10 h-10 flex items-center justify-center bg-purple-900/30 rounded-lg mr-4">
                                            <span class="text-purple-300 font-bold">
                                                @(mostRatedSongs.IndexOf(song) + 1)
                                            </span>
                                        </div>
                                        <div>
                                            <h4 class="font-semibold">@song.Title</h4>
                                            <p class="text-sm text-gray-400">@song.Artist • @song.Genre</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="flex items-center justify-end mb-1">
                                        <div class="flex mr-2">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                <svg class="w-4 h-4 @(i < Math.Floor(song.AverageRating) ? "text-yellow-400" : "text-gray-600")"
                                                     fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                </svg>
                                            }
                                        </div>
                                        <span class="font-bold">@song.AverageRating.ToString("F1")</span>
                                    </div>
                                    <p class="text-sm text-gray-400">
                                        @song.TotalRatings rating@(song.TotalRatings != 1 ? "s" : "")
                                        @if (song.LastRated.HasValue)
                                        {
                                            <span> • Last: @song.LastRated.Value.ToString("MMM d")</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Rating Trends -->
                <div class="glass p-6 rounded-xl">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold">Rating Trends</h2>
                        <div class="flex space-x-2">
                            <button @onclick="() => ChangeTimeRange(7)" class="px-3 py-1 text-sm @(daysRange == 7 ? "bg-purple-700" : "bg-gray-700") rounded">7d</button>
                            <button @onclick="() => ChangeTimeRange(30)" class="px-3 py-1 text-sm @(daysRange == 30 ? "bg-purple-700" : "bg-gray-700") rounded">30d</button>
                            <button @onclick="() => ChangeTimeRange(90)" class="px-3 py-1 text-sm @(daysRange == 90 ? "bg-purple-700" : "bg-gray-700") rounded">90d</button>
                            <button @onclick="() => ChangeTimeRange(180)" class="px-3 py-1 text-sm @(daysRange == 180 ? "bg-purple-700" : "bg-gray-700") rounded">180d</button>
                        </div>
                    </div>

                    <div class="h-80">
                        @if (ratingTrends.Any())
                        {
                            <div class="relative h-full">
                                <!-- Y-Axis Labels -->
                                <div class="absolute left-0 top-0 bottom-0 w-10 flex flex-col justify-between pb-12">
                                    @for (int i = 5; i >= 1; i--)
                                    {
                                        <div class="text-xs text-gray-400 text-right pr-2">@i</div>
                                    }
                                    <div class="text-xs text-gray-400 text-right pr-2">0</div>
                                </div>

                                <div class="ml-10 h-full @(ratingTrends.Count > 10 ? "overflow-x-auto" : "") px-4">
                                    @{
                                        var minWidth = ratingTrends.Count > 10 ? Math.Max(800, ratingTrends.Count * 40) : 100;
                                    }
                                    <div class="relative" style="min-width: @(minWidth)px; height: 100%;">

                                        <!-- Grid Lines -->
                                        <div class="absolute inset-0" style="height: calc(100% - 40px);">
                                            @for (int i = 0; i <= 5; i++)
                                            {
                                                <div class="absolute left-0 right-0 border-t border-gray-700" style="top: @(i * 20)%"></div>
                                            }
                                        </div>

                                        <!-- Points -->
                                        <div class="absolute inset-0" style="height: calc(100% - 40px);">
                                            @{
                                                var points = ratingTrends.Select((trend, index) => new
                                                {
                                                    X = (index * 100.0 / Math.Max(1, ratingTrends.Count - 1)) + "%",
                                                    Y = (5 - trend.AverageRating) * 20 + "%",
                                                    Trend = trend,
                                                    Index = index
                                                }).ToList();
                                            }

                                            <svg class="absolute inset-0 w-full h-full">
                                                @foreach (var point in points)
                                                {
                                                    <circle cx="@point.X" cy="@point.Y" r="4" fill="#FBBF24"
                                                            class="data-point hover:r-6 transition-all duration-200 cursor-pointer"
                                                            @onclick="() => ShowTooltip(point, point.Trend, point.Index)"
                                                            @onmouseenter="() => ShowTooltip(point, point.Trend, point.Index)" />
                                                }
                                            </svg>
                                        </div>

                                        <!-- X-Axis Labels -->
                                        <div class="absolute bottom-0 left-0 right-0 h-10 pt-2">
                                            @if (ratingTrends.Count > 0)
                                            {
                                                @if (ratingTrends.Count <= 10)
                                                {
                                                    <!-- Show all labels when few points -->
                                                    @foreach (var trend in ratingTrends)
                                                    {
                                                        var index = ratingTrends.IndexOf(trend);
                                                        var leftPercentage = (index * 100.0 / Math.Max(1, ratingTrends.Count - 1));
                                                        <div class="absolute text-xs text-gray-400 text-center whitespace-nowrap -translate-x-1/2" style="left: @(leftPercentage)%">
                                                            @(daysRange <= 90 ? trend.Date.ToString("MMM d") : trend.Date.ToString("MMM"))
                                                        </div>
                                                    }
                                                }
                                                else if (daysRange <= 30)
                                                {
                                                    <!-- Show all labels for 30 days -->
                                                    @foreach (var trend in ratingTrends)
                                                    {
                                                        var index = ratingTrends.IndexOf(trend);
                                                        var leftPercentage = (index * 100.0 / Math.Max(1, ratingTrends.Count - 1));
                                                        <div class="absolute text-xs text-gray-400 text-center whitespace-nowrap -translate-x-1/2" style="left: @(leftPercentage)%">
                                                            @trend.Date.ToString("MMM d")
                                                        </div>
                                                    }
                                                }
                                                else if (daysRange <= 90)
                                                {
                                                    <!-- Show weekly labels -->
                                                    @for (int i = 0; i < ratingTrends.Count; i += 7)
                                                    {
                                                        if (i < ratingTrends.Count)
                                                        {
                                                            var trend = ratingTrends[i];
                                                            var leftPercentage = (i * 100.0 / Math.Max(1, ratingTrends.Count - 1));
                                                            <div class="absolute text-xs text-gray-400 text-center whitespace-nowrap -translate-x-1/2" style="left: @(leftPercentage)%">
                                                                @trend.Date.ToString("MMM d")
                                                            </div>
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <!-- Show monthly labels -->
                                                    var lastMonth = -1;
                                                    @foreach (var trend in ratingTrends)
                                                    {
                                                        var index = ratingTrends.IndexOf(trend);
                                                        if (trend.Date.Month != lastMonth)
                                                        {
                                                            lastMonth = trend.Date.Month;
                                                            var leftPercentage = (index * 100.0 / Math.Max(1, ratingTrends.Count - 1));
                                                            <div class="absolute text-xs text-gray-400 text-center whitespace-nowrap -translate-x-1/2" style="left: @(leftPercentage)%">
                                                                @trend.Date.ToString("MMM")
                                                            </div>
                                                        }
                                                    }
                                                }
                                            }
                                        </div>

                                        <!-- Tooltip -->
                                        @if (hoveredPoint != null)
                                        {
                                            var shouldShowLeft = hoveredPoint.Index >= ratingTrends.Count / 2;
                                            <div class="absolute bg-gray-800 text-white text-xs px-3 py-2 rounded-lg shadow-lg z-50 border border-gray-700"
                                                 style="left: @(shouldShowLeft ? "calc(" + hoveredPoint.Left + " - 150px)" : hoveredPoint.Left);
                            top: @hoveredPoint.Top">
                                                <div class="font-semibold text-yellow-300">@hoveredPoint.Date</div>
                                                <div>Average: <span class="font-bold text-yellow-400">@hoveredPoint.AverageRating.ToString("F1")</span></div>
                                                <div>Ratings: <span class="font-bold text-purple-300">@hoveredPoint.TotalRatings</span></div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Stats -->
                            <div class="flex justify-end items-center mt-4 pt-4 border-t border-gray-700">
                                <div class="text-sm text-gray-400">
                                    @{
                                        var periodAvg = ratingTrends.Any() ? ratingTrends.Average(t => t.AverageRating).ToString("F1") : "0.0";
                                        var totalPeriodRatings = ratingTrends.Sum(t => t.TotalRatings);
                                    }
                                    Period Average: <span class="text-yellow-300 font-semibold">@periodAvg</span>
                                    • Total Ratings: <span class="text-purple-300 font-semibold">@totalPeriodRatings</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="flex flex-col items-center justify-center h-full text-gray-500">
                                <svg class="w-16 h-16 mb-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                                <p class="text-lg">No rating data available</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Genre Popularity -->
                <div class="glass p-6 rounded-xl lg:col-span-2">
                    <h2 class="text-xl font-bold mb-6">Genre Popularity</h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var genre in genrePopularity)
                        {
                            <div class="bg-gray-800/50 p-4 rounded-lg">
                                <div class="flex justify-between items-start mb-3">
                                    <div>
                                        <h3 class="font-semibold text-lg">@genre.Genre</h3>
                                        <p class="text-sm text-gray-400">
                                            @genre.TotalSongs song@(genre.TotalSongs != 1 ? "s" : "")
                                        </p>
                                    </div>
                                    <span class="px-3 py-1 bg-purple-900/30 text-purple-300 rounded-full text-sm">
                                        #@(genrePopularity.IndexOf(genre) + 1)
                                    </span>
                                </div>

                                <div class="space-y-3">
                                    <div>
                                        <div class="flex justify-between text-sm mb-1">
                                            <span class="text-gray-400">Ratings</span>
                                            <span class="font-semibold">@genre.TotalRatings</span>
                                        </div>
                                        <div class="h-2 bg-gray-700 rounded-full overflow-hidden">
                                            <div class="h-full bg-blue-500"
                                                 style="width: @(GetGenrePercentage(genre.TotalRatings))%">
                                            </div>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="flex justify-between text-sm mb-1">
                                            <span class="text-gray-400">Avg Rating</span>
                                            <span class="font-semibold">@genre.AverageRating.ToString("F1")</span>
                                        </div>
                                        <div class="h-2 bg-gray-700 rounded-full overflow-hidden">
                                            <div class="h-full bg-yellow-500"
                                                 style="width: @(genre.AverageRating * 20)%">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="pt-3 border-t border-gray-700">
                                        <div class="flex justify-between">
                                            <span class="text-sm text-gray-400">Popularity Score</span>
                                            <span class="font-bold text-purple-300">
                                                @Math.Round(genre.PopularityScore)
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (!genrePopularity.Any())
                    {
                        <div class="text-center py-8 text-gray-500">
                            No genre data available
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .glass {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>

@code {
    private bool isLoading = true;
    private List<MostRatedSongDto> mostRatedSongs = new();
    private List<RatingTrendDto> ratingTrends = new();
    private List<GenrePopularityDto> genrePopularity = new();
    private AnalyticsSummaryDto? summary;
    private int topN = 10;
    private int daysRange = 30;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalyticsData();
    }

    private async Task LoadAnalyticsData()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var mostRatedTask = Http.GetFromJsonAsync<List<MostRatedSongDto>>($"api/analytics/most-rated/{topN}");
            var trendsTask = Http.GetFromJsonAsync<List<RatingTrendDto>>($"api/analytics/trends?startDate={DateTime.UtcNow.AddDays(-daysRange):yyyy-MM-dd}&endDate={DateTime.UtcNow:yyyy-MM-dd}");
            var genresTask = Http.GetFromJsonAsync<List<GenrePopularityDto>>("api/analytics/genres");
            var summaryTask = Http.GetFromJsonAsync<AnalyticsSummaryDto>("api/analytics/summary");

            await Task.WhenAll(mostRatedTask, trendsTask, genresTask, summaryTask);

            mostRatedSongs = await mostRatedTask ?? new();
            ratingTrends = await trendsTask ?? new();
            genrePopularity = await genresTask ?? new();
            summary = await summaryTask;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading analytics: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ChangeTopN(int newTopN)
    {
        topN = newTopN;
        await LoadAnalyticsData();
    }

    private double GetGenrePercentage(int genreRatings)
    {
        if (!genrePopularity.Any()) return 0;

        var maxRatings = genrePopularity.Max(g => g.TotalRatings);
        return maxRatings > 0 ? (genreRatings * 100.0 / maxRatings) : 0;
    }

    private HoveredPoint? hoveredPoint = null;

    private class HoveredPoint
    {
        public string Date { get; set; } = "";
        public double AverageRating { get; set; }
        public int TotalRatings { get; set; }
        public string Left { get; set; } = "0px";
        public string Top { get; set; } = "0px";
        public int Index { get; set; }
    }

    private void ShowTooltip(object point, RatingTrendDto trend, int index)
    {
        var pointObj = point as dynamic;
        hoveredPoint = new HoveredPoint
        {
            Date = trend.Date.ToString("MMM d, yyyy"),
            AverageRating = trend.AverageRating,
            TotalRatings = trend.TotalRatings,
            Left = "calc(" + ((ratingTrends.IndexOf(trend) * 100.0) / Math.Max(1, ratingTrends.Count - 1)) + "% + 20px)",
            Top = "calc(" + ((5 - trend.AverageRating) * 20) + "% - 40px)",
            Index = index
        };
    }

    private async Task ChangeTimeRange(int days)
    {
        daysRange = days;
        hoveredPoint = null;
        await LoadAnalyticsData();
    }
}
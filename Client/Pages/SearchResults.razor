@page "/search"
@inject HttpClient Http
@inject NavigationManager Nav
@using music_manager_starter.Shared

@code {
    private List<Song>? results;
    private string query = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadResults();
        Nav.LocationChanged += OnLocationChanged;
    }

    private async Task LoadResults()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);

        query = queryParams["q"] ?? string.Empty;

        var apiUrl = string.IsNullOrWhiteSpace(query)
            ? "api/songs/search"
            : $"api/songs/search?query={Uri.EscapeDataString(query)}";

        try
        {
            var response = await Http.GetFromJsonAsync<SongSearchResponse>(apiUrl);
            results = response?.Results ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading results: {ex.Message}");
            results = new();
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await LoadResults();
        StateHasChanged();
    }

    private MarkupString Highlight(string text)
    {
        if (string.IsNullOrWhiteSpace(query))
            return new MarkupString(text);

        var highlighted = text.Replace(
            query,
            $"<mark>{query}</mark>",
            StringComparison.OrdinalIgnoreCase);

        return new MarkupString(highlighted);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}


<div class="p-4 bg-gray-900/50 h-full">
    <h2 class="text-xl font-semibold text-white mb-4">Search Results</h2>

    <div class="mb-4">
        <button class="bg-gray-700 text-white px-3 py-1 rounded">
            Advanced Filters
        </button>
    </div>

    @if (results == null)
    {
        <p class="text-gray-400">Searching...</p>
    }
    else if (!results.Any())
    {
        <p class="text-gray-400">No results found.</p>
    }
    else
    {
        foreach (var song in results)
        {
            <div class="p-3 bg-gray-700 text-gray-300 rounded mb-2">
                <strong>@Highlight(song.Title)</strong>
                <div class="text-sm text-gray-300">
                    @Highlight(song.Artist) • @Highlight(song.Album)
                </div>
            </div>
        }
    }
</div>



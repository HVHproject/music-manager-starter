@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS


@code {
    private string searchText = string.Empty;
    private Timer? debounceTimer;

    private void OnSearchInput()
    {
        debounceTimer?.Dispose();
        debounceTimer = new Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                var encoded = Uri.EscapeDataString(searchText ?? string.Empty);
                var uri = Nav.ToBaseRelativePath(Nav.Uri);

                Nav.NavigateTo($"/search?q={encoded}", replace: uri.StartsWith("search"));

                await JS.InvokeVoidAsync("focusSearchInput");
            });
        }, null, 500, Timeout.Infinite);
    }
}


<div class="flex h-screen">
    <NavMenu />

    <div class="flex-1 flex flex-col bg-gray-800 md:ml-64">
        <div class="top-bar px-6 py-4 bg-gray-900 text-white flex items-center justify-between">
            <h1 class="text-xl font-semibold">Music</h1>

            <div class="relative">
                <input type="text"
                       id="global-search-input"
                       placeholder="Search..."
                       class="bg-gray-700 text-white px-4 py-2 rounded-full focus:outline-none"
                       @bind-value="searchText"
                       @bind-value:event="oninput"
                       @bind-value:after="OnSearchInput" />

                <span class="absolute right-3 top-3 text-gray-400">
                    <i class="fas fa-search"></i>
                </span>
            </div>
        </div>

        <div class="p-0 overflow-y-auto flex-1">
            @Body
        </div>
    </div>
</div>